{
  "name": "reluctant-obsidian-parser",
  "version": "0.0.1",
  "description": "Obsidian markdown syntax parser",
  "repository": "github:spencermountain/reluctant-obsidian-parser",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "minimumReleaseAge": "1 day",
  "scripts": {
    "build": "rollup -c --silent",
    "test": "tape \"tests/*.test.js\" | tap-dancer",
    "watch": "node --watch scratch.js",
    "lint": "eslint .",
    "prepack": "pnpm build"
  },
  "type": "module",
  "main": "./builds/index.cjs",
  "files": [
    "src",
    "builds",
    "types"
  ],
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "dependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "mdast-util-to-markdown": "^2.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "rollup-plugin-filesize-check": "^2.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "10.11.0",
    "rollup": "^4.64.7",
    "tap-dancer": "0.4.2",
    "tape": "^5.10.2"
  },
  "license": "MIT",
  "module": "./builds/index.js",
  "exports": {
    ".": {
      "import": "./builds/index.js",
      "require": "./builds/index.cjs"
    },
    "./remark": {
      "import": "./builds/remark.js",
      "require": "./builds/remark.cjs"
    }
  },
  "sideEffects": false
}
