{
  "name": "reluctant-obsidian",
  "version": "0.0.1",
  "description": "Obsidian markdown syntax parser",
  "repository": "github:spencermountain/reluctant-obsidian",
  "author": "Spencer Kelly <spencermountain@gmail.com> (https://spencermountain.dev)",
  "minimumReleaseAge": "1 day",
  "scripts": {
    "build": "pnpm compile && rollup -c rollup.config.ts --silent",
    "test": "node scripts/test.ts | tap-dancer",
    "testb": "TESTENV=prod pnpm run test",
    "watch": "node --watch scratch.ts",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "prepack": "pnpm build",
    "compile": "tsc -p tsconfig.build.json && node scripts/declarations.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "type": "module",
  "main": "./builds/obsidian-parser.cjs",
  "files": [
    "builds",
    "types"
  ],
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true,
    "printWidth": 100
  },
  "dependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "js-yaml": "^5.5.0",
    "mdast-util-to-markdown": "^2.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "rollup-plugin-filesize-check": "^2.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "10.11.0",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-util-types": "^2.0.3",
    "rollup": "^4.64.7",
    "tap-dancer": "0.4.2",
    "tape": "^5.10.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "module": "./builds/obsidian-parser.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/obsidian-parser.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/obsidian-parser.cjs"
      }
    },
    "./remark": {
      "import": {
        "types": "./types/remark.d.ts",
        "default": "./builds/remark/obsidian-parser.mjs"
      },
      "require": {
        "types": "./types/remark.d.cts",
        "default": "./builds/remark/obsidian-parser.cjs"
      }
    }
  },
  "sideEffects": false,
  "types": "./types/index.d.ts"
}
